# Database
DATABASE_URL="postgresql://user:password@localhost:5432/family-picnic"
# Shadow database used by `prisma migrate diff` to generate new
# migrations against the existing schema. Create it locally with:
#   docker exec family-picnic-postgres psql -U user -d family-picnic \
#     -c "CREATE DATABASE family_picnic_shadow;"
SHADOW_DATABASE_URL="postgresql://user:password@localhost:5432/family_picnic_shadow"

# Dev auth bypass (set DEV_AUTH_ENABLED=true to enable username/password login)
DEV_AUTH_ENABLED=false
DEV_AUTH_USERNAME=admin
DEV_AUTH_PASSWORD=change-me

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-random-string"

# Google OAuth
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Apple Sign-In (FPP-57 / FPP-33)
# Generate the key in Apple Developer Portal under "Keys" -> "+" ->
# "Sign in with Apple" -> configure the Services ID as the primary
# app. The PEM private key goes here (newlines may be escaped as `\n`).
# AUTH_APPLE_ID is the Services ID (not the App ID prefix).
# AUTH_APPLE_TEAM_ID is the 10-character Apple Developer Team ID.
# AUTH_APPLE_KEY_ID is the key id shown next to the downloaded key.
# AUTH_APPLE_PRIVATE_KEY is the PEM-encoded ES256 private key from the
# .p8 file. The client secret is generated at runtime as a short-lived
# JWT (see src/lib/apple-client-secret.ts); never commit the key.
# Do not enable in production until App Store requirements are
# confirmed by the release team.
AUTH_APPLE_ID=""
AUTH_APPLE_TEAM_ID=""
AUTH_APPLE_KEY_ID=""
AUTH_APPLE_PRIVATE_KEY=""

# Facebook Login (FPP-57 / FPP-32)
# Create an app at https://developers.facebook.com. Add "Facebook Login"
# and configure the Valid OAuth Redirect URI as
# `${NEXTAUTH_URL}/api/auth/callback/facebook`. Do not enable until
# business verification is complete (Facebook requires it for production).
AUTH_FACEBOOK_ID=""
AUTH_FACEBOOK_SECRET=""

# Twilio (SMS)
# Account SID, auth token, and the E.164 sender phone number provisioned in
# your Twilio account. TWILIO_PHONE_NUMBER must be a valid E.164 value
# (e.g. +15551234567). It is bound from the OpenBao-backed Kubernetes secret
# `secret/family-picnic-dev/nextjs:twilio-phone-number` via the
# ExternalSecret resource in `kubernetes/overlays/pugquilt-dev/external-secrets.yaml`.
# TWILIO_ENABLED gates the worker SMS dispatch branch in deliverOne
# (src/lib/ow-workflows.ts). When unset or "false", queued SMS rows are
# marked FAILED with reason sms_disabled_for_launch. Set to "true" only
# after Twilio credentials are provisioned and tested.
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Twilio Email (sender address — Twilio SID + Token are shared with the SMS block above)
TWILIO_FROM_EMAIL="noreply@family-picnic.example.com"

# Feedback inbox — where the "Send feedback" form delivers user messages.
# Override per environment if you need to triage in a shared mailbox.
FEEDBACK_TO_EMAIL="info@foliapicnic.com"

# S3-compatible Storage (SeaweedFS in-cluster, exposed at i.foliapicnic.com)
# S3_ENDPOINT / S3_PUBLIC_URL / AWS_REGION / S3_BUCKET_NAME are set by
# populate-openbao-secrets.sh after the first run; leave them blank here.
# Only override S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY if you want to
# pin a specific identity — otherwise the script generates a safe pair.
S3_ENDPOINT=""
S3_PUBLIC_URL=""
AWS_REGION="us-east-1"
S3_BUCKET_NAME="family-picnic-photos"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# AWS_* aliases are what the AWS SDK reads; populate-openbao-secrets.sh
# writes them from the same S3_* values above.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# PhotoPrism
PHOTOPRISM_URL="http://photoprism:2342"
PHOTOPRISM_API_KEY=""

# Observability
LOG_LEVEL="info"
SENTRY_DSN=""
OTEL_EXPORTER_OTLP_ENDPOINT=""

# Cron / Scheduled Tasks
CRON_SECRET=""

# Trusted proxy IPs for resolving the real client IP from x-forwarded-for.
# Comma-separated IPv4 addresses. When unset or empty, no proxy headers are
# trusted and smsConsentIp is recorded as null. Set to your edge proxy IPs in
# each environment (e.g. "10.0.0.1,10.0.0.2" for an internal ALB).
TRUSTED_PROXY_IPS=""

# Google Maps (places autocomplete + map embed)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# PostHog (analytics)
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Stripe (credit card processing)
# Use sk_test_*/pk_test_*/whsec_* in dev. Switch to sk_live_*/pk_live_*/whsec_*
# (and a different webhook secret) in production. STRIPE_WEBHOOK_SECRET comes
# from `stripe listen --forward-to http://localhost:3000/api/stripe/webhook`
# in dev, or from `scripts/setup-stripe-webhook.sh` in stage/prod.
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Used by scripts/setup-stripe-webhook.sh to register the webhook endpoint
# against Stripe. sk_test_* for dev/stage, sk_live_* for prod. Not read by
# the Next.js application at runtime — only by the bootstrap script.
STRIPE_API_KEY=""
