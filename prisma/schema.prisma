generator client {
  provider = "prisma-client"
  output   = "../src/lib/generated"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN_ADULT
  ADMIN
}

enum CommunicationPreference {
  EMAIL
  SMS
  BOTH
  NONE
}

enum Relationship {
  SPOUSE
  CHILD
  PARENT
  SIBLING
  INLAW
  COUSIN
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CLOSED
  CANCELLED
}

enum InvitationStatus {
  PENDING
  SENT
  DELIVERED
  USED
  EXPIRED
}

enum RSVPStatus {
  INVITED
  PENDING
  CONFIRMED
  DECLINED
  WAITLISTED
}

enum RsvpAttending {
  YES
  NO
  MAYBE
}

enum PotluckCategory {
  MAIN
  SIDE
  DESSERT
  DRINK
  OTHER
}

enum SlotType {
  LIMITED
  UNLIMITED
}

enum CommunicationChannel {
  EMAIL
  SMS
}

enum CommunicationStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  UNSUBSCRIBED
}

// reactions are stored as emoji strings

model Household {
  id                String    @id @default(cuid())
  // 1..80 chars and unique (case-insensitive, ignoring whitespace) among
  // active rows. Enforced at the database level by a CHECK constraint and
  // a partial unique index in migration
  // 20260803083930_household_name_field; Prisma cannot express the
  // case-insensitive functional index directly, so it is not declared here.
  name              String
  parentHouseholdId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  parent           Household?  @relation("HouseholdTree", fields: [parentHouseholdId], references: [id])
  children         Household[] @relation("HouseholdTree")
  users            User[]
  dependents       Dependent[]
  invitations      Invitation[]
  photos           Photo[]
  members          HouseholdMember[]

  @@index([parentHouseholdId])
  @@index([deletedAt])
}

model HouseholdMember {
  id          String    @id @default(cuid())
  householdId String
  name        String
  age         Int?
  // Optional relationship to the account holder (e.g. SPOUSE,
  // CHILD, PARENT). Kept as a free-form string so the onboarding
  // wizard can store user input without a Prisma enum migration
  // when the picker list grows. QUB-21 removes dietary fields
  // from this scope; relationship is structural.
  relationship String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  rsvpAttendances RsvpMemberAttendance[]

  @@index([householdId])
  @@index([deletedAt])
}

model RsvpMemberAttendance {
  id                   String        @id @default(cuid())
  rsvpId               String
  householdMemberId    String?
  // Snapshots preserve the member's name/age at the time of the RSVP
  // so a later member edit or delete does not rewrite the saved
  // confirmation. memberNameSnapshot is required; memberAgeSnapshot
  // is optional to match the underlying HouseholdMember model.
  memberNameSnapshot   String
  memberAgeSnapshot    Int?
  attending            RsvpAttending @default(YES)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  rsvp    RSVP             @relation(fields: [rsvpId], references: [id], onDelete: Cascade)
  member  HouseholdMember? @relation(fields: [householdMemberId], references: [id], onDelete: SetNull)

  @@unique([rsvpId, householdMemberId])
  @@index([rsvpId])
  @@index([householdMemberId])
  @@index([attending])
}

model User {
  id                     String                 @id @default(cuid())
  email                  String                 @unique
  name                   String
  role                   Role                   @default(ADMIN_ADULT)
  householdId            String?
  communicationPreference CommunicationPreference @default(EMAIL)
  phoneNumber            String?
  smsConsent             Boolean                @default(false)
  smsConsentAt           DateTime?
  smsConsentIp           String?
  onboardingCompletedAt  DateTime?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  deletedAt              DateTime?
  devPassword            String?

  household          Household?        @relation(fields: [householdId], references: [id])
  managedDependents  Dependent[]
  invitations        Invitation[]      @relation("UserInvitations")
  invitedByMe        Invitation[]     @relation("InvitedByUser")
  rsvps              RSVP[]
  uploadedPhotos     Photo[]
  sentCommunications CommunicationLog[] @relation("SentByUser")
  receivedCommunications CommunicationLog[] @relation("ReceivedByUser")
  scheduledBroadcasts  ScheduledBroadcast[] @relation("ScheduledByUser")
  photoReactions     PhotoReaction[]
  adminAuditLogs     AdminAuditLog[]
  eventAdmins        EventAdmin[]
  registrations      Registration[]
  refundsIssued      Refund[]          @relation("RefundIssuer")

  @@index([householdId])
  @@index([role])
  @@index([deletedAt])
  @@index([phoneNumber])
}

model Dependent {
  id              String       @id @default(cuid())
  name            String
  relationship    Relationship
  age             Int?
  dietaryLabels   String[]
  isChild         Boolean      @default(false)
  householdId     String
  managedByUserId String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?

  household    Household   @relation(fields: [householdId], references: [id])
  managedBy    User        @relation(fields: [managedByUserId], references: [id])

  @@index([householdId])
  @@index([managedByUserId])
  @@index([deletedAt])
}

model Event {
  id           String     @id @default(cuid())
  name         String
  date         DateTime
  location     String
  mapImageUrl  String?
  description  String
  rsvpDeadline DateTime?
  maxCapacity  Int?
  // Optional per-attendee fee. When null, registration is free and no
  // Stripe flow is shown. Amounts are in the smallest currency unit
  // (cents for USD) to avoid floating-point drift.
  registrationFeeCents Int?       @default(0)
  currency             String     @default("usd")
  // Minimum age (inclusive) for an attendee to owe the per-attendee fee.
  // Attendees with a known age strictly below this threshold are free.
  // Attendees with `age = null` are skipped (the fee calc treats them as
  // non-qualifying so a missing snapshot never silently bills the user).
  // Default 0 means "every attendee pays", which matches the FPP-47
  // behavior that shipped before per-attendee age logic existed.
  registrationFeeMinAge Int       @default(0)
  status       EventStatus @default(DRAFT)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  invitations        Invitation[]
  rsvps              RSVP[]
  potluckSlots       PotluckSlot[]
  communications     CommunicationLog[]
  scheduledBroadcasts ScheduledBroadcast[]
  photos             Photo[]
  adminAuditLogs     AdminAuditLog[]
  admins             EventAdmin[]
  registrations      Registration[]

  @@index([status])
  @@index([date])
  @@index([rsvpDeadline])
}

model Invitation {
  id              String           @id @default(cuid())
  eventId         String
  userId          String?
  householdId     String?
  status          InvitationStatus @default(PENDING)
  invitedByUserId String
  createdAt       DateTime         @default(now())
  token           String?          @unique
  expiresAt       DateTime?
  sentAt          DateTime?

  event       Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user        User?      @relation("UserInvitations", fields: [userId], references: [id])
  household   Household? @relation(fields: [householdId], references: [id])
  invitedBy   User       @relation("InvitedByUser", fields: [invitedByUserId], references: [id])

  @@unique([eventId, userId])
  @@unique([eventId, householdId])
  @@index([eventId])
  @@index([userId])
  @@index([householdId])
  @@index([invitedByUserId])
  @@index([status])
  @@index([token])
}

model RSVP {
  id               String     @id @default(cuid())
  eventId          String
  userId           String
  householdId      String
  status           RSVPStatus @default(INVITED)
  headcount        Int        @default(1)
  // FPP-55: the platform-level dietary restrictions field was removed
  // from the application. Historical values stay in the database column
  // for audit (the column is preserved but not exposed by Prisma); the
  // application no longer reads or writes it.
  respondedAt      DateTime?
  modifiedAt       DateTime   @updatedAt
  waitlistPosition Int?

  event          Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  potluckSignups PotluckSignup[]
  memberAttendances RsvpMemberAttendance[]

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@index([householdId])
  @@index([status])
  @@index([waitlistPosition])
}

model PotluckSlot {
  id             String         @id @default(cuid())
  eventId        String
  category       PotluckCategory
  name           String
  slotType       SlotType
  maxSignups     Int?
  currentSignups Int            @default(0)

  event    Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  signups  PotluckSignup[]

  @@index([eventId])
  @@index([category])
}

model PotluckSignup {
  id            String   @id @default(cuid())
  slotId        String
  rsvpId        String
  dishName      String
  servings      Int      @default(1)
  dietaryLabels String[]
  claimedAt     DateTime @default(now())

  slot PotluckSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  rsvp RSVP        @relation(fields: [rsvpId], references: [id], onDelete: Cascade)

  @@unique([slotId, rsvpId])
  @@index([slotId])
  @@index([rsvpId])
}

model CommunicationLog {
  id               String               @id @default(cuid())
  eventId          String
  sentByUserId     String
  recipientUserId  String?
  channel          CommunicationChannel
  messageId        String?
  toPhoneNumber    String?
  fromPhoneNumber  String?
  status           CommunicationStatus  @default(QUEUED)
  errorCode        String?
  errorMessage     String?
  attemptedAt      DateTime             @default(now())
  deliveredAt      DateTime?

  event     Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sentBy    User    @relation("SentByUser", fields: [sentByUserId], references: [id], onDelete: Cascade)
  recipient User?   @relation("ReceivedByUser", fields: [recipientUserId], references: [id])

  @@index([eventId])
  @@index([recipientUserId])
  @@index([status])
  @@index([sentByUserId])
}

model Photo {
  id               String    @id @default(cuid())
  eventId          String
  uploadedByUserId String
  householdId      String
  photoPrismId     String
  caption          String?
  url              String
  thumbnailUrl     String?
  createdAt        DateTime  @default(now())
  deletedAt        DateTime?

  event      Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  uploadedBy User           @relation(fields: [uploadedByUserId], references: [id], onDelete: Cascade)
  household  Household      @relation(fields: [householdId], references: [id])
  reactions  PhotoReaction[]

  @@index([eventId])
  @@index([uploadedByUserId])
  @@index([householdId])
  @@index([photoPrismId])
  @@index([deletedAt])
}

model PhotoReaction {
  id        String   @id @default(cuid())
  photoId   String
  userId    String
  reaction  String
  createdAt DateTime @default(now())

  photo Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([photoId, userId, reaction])
  @@index([photoId])
  @@index([userId])
}

model AdminAuditLog {
  id        String   @id @default(cuid())
  userId    String
  eventId   String?
  action    String
  oldValue  Json?
  newValue  Json?
  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([eventId])
  @@index([createdAt])
  @@index([action])
}

enum AdminPermission {
  OWNER
  COADMIN
  INVITER
}

enum ScheduledBroadcastStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum RegistrationStatus {
  PENDING
  PAID
  REFUNDED
  FORFEITED
  CANCELLED
}

enum ChargeStatus {
  REQUIRES_PAYMENT_METHOD
  REQUIRES_CONFIRMATION
  REQUIRES_ACTION
  PROCESSING
  REQUIRES_CAPTURE
  SUCCEEDED
  CANCELED
  FAILED
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
}

model ScheduledBroadcast {
  id             String                    @id @default(cuid())
  eventId        String
  sentByUserId   String
  message        String
  channel        CommunicationChannel
  recipientType  String
  recipientIds   Json?
  scheduledAt    DateTime
  status         ScheduledBroadcastStatus  @default(PENDING)
  processedAt    DateTime?
  errorMessage   String?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sentBy  User  @relation("ScheduledByUser", fields: [sentByUserId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([sentByUserId])
  @@index([status])
  @@index([scheduledAt])
}

model EventAdmin {
  id        String         @id @default(cuid())
  eventId   String
  userId    String
  role      AdminPermission @default(COADMIN)
  createdAt DateTime       @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

model Registration {
  id            String             @id @default(cuid())
  eventId       String
  userId        String
  // The household the charge applies to. May be null for users without a
  // household record. Carried on the row for reporting, not used by Stripe.
  householdId   String?
  // Snapshot of the per-attendee fee at charge time. Immutable per
  // registration so that retroactive fee changes do not corrupt history.
  amountCents   Int
  currency      String             @default("usd")
  status        RegistrationStatus @default(PENDING)
  // Sum of SUCCEEDED refund amounts in cents. Used to derive "fully refunded"
  // and to render remaining-balance UI without re-querying the refunds table.
  refundedCents Int                @default(0)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  charges Charge[]
  refunds Refund[]

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@index([status])
}

model Charge {
  id                    String       @id @default(cuid())
  registrationId        String
  // Stripe's PaymentIntent id (pi_...). Unique globally. Stored on every
  // row even after the Stripe object is deleted so the audit trail survives.
  stripePaymentIntentId String       @unique
  // Snapshot of the charge amount. Equal to the registration amount for the
  // first attempt; retries and partial captures can differ.
  amountCents           Int
  currency              String       @default("usd")
  status                ChargeStatus @default(REQUIRES_PAYMENT_METHOD)
  // Hosted receipt URL from Stripe. Null until payment_intent.succeeded.
  receiptUrl            String?
  // Set the first time the receipt email goes out for this charge. The
  // webhook and the admin "resend receipt" action check this to avoid
  // re-mailing on retries.
  receiptSentAt         DateTime?
  // The last error code/message Stripe reported, if any. Helps the admin
  // triage a row without re-querying Stripe.
  lastErrorCode         String?
  lastErrorMessage      String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  refunds      Refund[]

  @@index([registrationId])
  @@index([status])
}

model Refund {
  id               String       @id @default(cuid())
  chargeId         String
  // Registration is denormalized onto the Refund for fast aggregation and to
  // keep refund rows queryable without joining through Charge -> Registration.
  registrationId   String
  // Stripe's Refund id (re_...). Unique when present; null until the refund
  // is created on Stripe's side.
  stripeRefundId   String?      @unique
  amountCents      Int
  currency         String       @default("usd")
  status           RefundStatus @default(PENDING)
  // Free-form reason captured from the admin ("duplicate", "fraudulent",
  // "requested_by_customer", or custom).
  reason           String?
  // The admin who issued the refund. Required: every refund is auditable.
  refundedByUserId String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  charge       Charge       @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  refundedBy   User         @relation("RefundIssuer", fields: [refundedByUserId], references: [id])

  @@index([chargeId])
  @@index([registrationId])
  @@index([status])
  @@index([refundedByUserId])
}