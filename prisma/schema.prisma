generator client {
  provider = "prisma-client"
  output   = "../src/lib/generated"
}

datasource db {
  provider = "postgresql"
}

// Role taxonomy:
//   - SUPER_ADMIN: platform-level admin with global access.
//   - ADMIN: adult family member with admin access (e.g. household tools).
//   - ADULT: default role for newly signed-up adult family members (no admin access).
//   - HOST: a per-event role scoped via the EventAdmin join row.
enum Role {
  SUPER_ADMIN
  ADMIN
  ADULT
  HOST
}

enum CommunicationPreference {
  EMAIL
  SMS
  BOTH
  NONE
}

enum Relationship {
  SPOUSE
  CHILD
  PARENT
  SIBLING
  INLAW
  COUSIN
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CLOSED
  CANCELLED
}

enum InvitationStatus {
  PENDING
  SENT
  DELIVERED
  USED
  EXPIRED
}

enum RSVPStatus {
  INVITED
  PENDING
  CONFIRMED
  DECLINED
  WAITLISTED
}

enum RsvpAttending {
  YES
  NO
  MAYBE
}

enum PotluckCategory {
  MAIN
  SIDE
  DESSERT
  DRINK
  OTHER
}

enum SlotType {
  LIMITED
  UNLIMITED
}

enum CommunicationChannel {
  EMAIL
  SMS
}

enum CommunicationStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  SKIPPED
  UNSUBSCRIBED
}

enum CommunicationLogKind {
  // The default for pre-FPP-88 rows and any general broadcast
  // that does not fit a more specific kind. The send pipeline
  // picks these up by default.
  BROADCAST
  // FPP-88: invitation sends. `body` holds the wizard URL the
  // recipient clicks. The send pipeline formats the email or
  // SMS body from this URL.
  INVITATION
  // FPP-88: forwarded decline notes. The guest attached a note
  // when declining and the note was forwarded to the event
  // owner via this row. `body` holds the note text.
  DECLINE_NOTE
}

// reactions are stored as emoji strings

model Household {
  id                String    @id @default(cuid())
  // 1..80 chars and unique (case-insensitive, ignoring whitespace) among
  // active rows. Enforced at the database level by a CHECK constraint and
  // a partial unique index in migration
  // 20260803083930_household_name_field; Prisma cannot express the
  // case-insensitive functional index directly, so it is not declared here.
  name              String
  parentHouseholdId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  parent      Household?        @relation("HouseholdTree", fields: [parentHouseholdId], references: [id])
  children    Household[]       @relation("HouseholdTree")
  users       User[]
  invitations Invitation[]
  photos      Photo[]
  members     HouseholdMember[]

  @@index([parentHouseholdId])
  @@index([deletedAt])
}

model HouseholdMember {
  id           String    @id @default(cuid())
  householdId  String
  name         String
  // FPP-122: age is now required on every household member. It drives
  // the per-attendee registration fee in the RSVP flow, so a NULL
  // would silently drop the member from the fee calculation. Backfill
  // applied in migration 20260817090000_fpp122_require_age.
  age          Int
  // Optional relationship to the account holder (e.g. SPOUSE,
  // CHILD, PARENT). Kept as a free-form string so the onboarding
  // wizard can store user input without a Prisma enum migration
  // when the picker list grows. QUB-21 removes dietary fields
  // from this scope; relationship is structural.
  relationship String?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  household       Household              @relation(fields: [householdId], references: [id], onDelete: Cascade)
  rsvpAttendances RsvpMemberAttendance[]

  @@index([householdId])
  @@index([deletedAt])
}

model RsvpMemberAttendance {
  id                 String        @id @default(cuid())
  rsvpId             String
  householdMemberId  String?
  // Snapshots preserve the member's name/age at the time of the RSVP
  // so a later member edit or delete does not rewrite the saved
  // confirmation. memberNameSnapshot is required; memberAgeSnapshot
  // is optional to match the underlying HouseholdMember model.
  memberNameSnapshot String
  memberAgeSnapshot  Int?
  attending          RsvpAttending @default(YES)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  rsvp   RSVP             @relation(fields: [rsvpId], references: [id], onDelete: Cascade)
  member HouseholdMember? @relation(fields: [householdMemberId], references: [id], onDelete: SetNull)

  @@unique([rsvpId, householdMemberId])
  @@index([rsvpId])
  @@index([householdMemberId])
  @@index([attending])
}

model User {
  id                      String                  @id @default(cuid())
  email                   String                  @unique
  name                    String
  role                    Role                    @default(ADULT)
  householdId             String?
  communicationPreference CommunicationPreference @default(EMAIL)
  phoneNumber             String?
  smsConsent              Boolean                 @default(false)
  smsConsentAt            DateTime?
  smsConsentIp            String?
  // True when the user's email is a third-party alias (Apple Private
  // Relay and similar). Inbound mail to these addresses is not
  // delivered to the user, so the admin UI surfaces a warning and
  // invitation/broadcast flows should prefer phone or household
  // channels for these accounts.
  emailIsRelay            Boolean                 @default(false)
  onboardingCompletedAt   DateTime?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  deletedAt               DateTime?
  devPassword             String?

  household              Household?           @relation(fields: [householdId], references: [id])
  invitations            Invitation[]         @relation("UserInvitations")
  invitedByMe            Invitation[]         @relation("InvitedByUser")
  rsvps                  RSVP[]
  uploadedPhotos         Photo[]
  sentCommunications     CommunicationLog[]   @relation("SentByUser")
  receivedCommunications CommunicationLog[]   @relation("ReceivedByUser")
  scheduledBroadcasts    ScheduledBroadcast[] @relation("ScheduledByUser")
  photoReactions         PhotoReaction[]
  adminAuditLogs         AdminAuditLog[]
  auditLogs              AuditLog[]
  eventAdmins            EventAdmin[]
  registrations          Registration[]
  refundsIssued          Refund[]             @relation("RefundIssuer")
  linkedIdentities       LinkedIdentity[]
  // FPP-43: PDF attachments uploaded by this user.
  uploadedAttachments    EventAttachment[]

  @@index([householdId])
  @@index([role])
  @@index([deletedAt])
  @@index([phoneNumber])
}

model Event {
  id                    String      @id @default(cuid())
  name                  String
  date                  DateTime
  location              String
  // FPP-145: optional host-defined display name for the location. When
  // set, the public event page surfaces this string instead of the
  // `location` row (which usually holds the Google Places formatted
  // address from the admin autocomplete). The two are decoupled so the
  // host can add context that Google doesn't know about — e.g.
  // "Shaver Lake - Camp Edison Tannenager Site" alongside a map pin
  // at the resolved Shaver Lake coordinates.
  customLocationName    String?
  lat                   Float?
  lng                   Float?
  placeId               String?
  mapImageUrl           String?
  // FPP-60: optional per-event hero image. When set, the public event
  // page renders it in place of the static map fallback (or default
  // gradient). Stored as a public URL once the upload PUT lands in
  // S3. Existing events backfill with NULL so the prior map fallback
  // keeps rendering until the host sets an image.
  featuredImageUrl      String?
  description           String
  // FPP-136: optional markdown/freeform additional info for the event.
  // Displayed in the dedicated "Additional Info" tab alongside PDF attachments.
  additionalInfo        String?
  rsvpDeadline          DateTime?
  maxCapacity           Int?
  // Optional per-attendee fee. When null, registration is free and no
  // Stripe flow is shown. Amounts are in the smallest currency unit
  // (cents for USD) to avoid floating-point drift.
  registrationFeeCents  Int?        @default(0)
  currency              String      @default("usd")
  // Minimum age (inclusive) for an attendee to owe the per-attendee fee.
  // Attendees with a known age strictly below this threshold are free.
  // Attendees with `age = null` are skipped (the fee calc treats them as
  // non-qualifying so a missing snapshot never silently bills the user).
  // Default 0 means "every attendee pays", which matches the FPP-47
  // behavior that shipped before per-attendee age logic existed.
  registrationFeeMinAge Int         @default(0)
  status                EventStatus @default(DRAFT)
  // FPP-68 / QUB-12: archive flag. When non-null, the event is
  // hidden from the active admin event list and surfaced under
  // "Past events" instead. Distinct from the `status` enum
  // (DRAFT/PUBLISHED/CLOSED/CANCELLED): archiving is orthogonal to
  // the lifecycle, so a CLOSED event can be archived without
  // re-opening it (QUB-11 / FPP-70 reopen), and a PUBLISHED event
  // can be archived when the host wants to retire it from the
  // active roster without flipping it to CLOSED.
  //
  // Backfill invariant: every pre-FPP-68 row leaves `archivedAt`
  // null. The admin "Past events" view surfaces both
  // `archivedAt IS NOT NULL` AND rows whose `date < now` so legacy
  // events are still discoverable. See FPP-68 acceptance criteria.
  archivedAt            DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  invitations         Invitation[]
  rsvps               RSVP[]
  potluckSlots        PotluckSlot[]
  communications      CommunicationLog[]
  scheduledBroadcasts ScheduledBroadcast[]
  photos              Photo[]
  adminAuditLogs      AdminAuditLog[]
  admins              EventAdmin[]
  registrations       Registration[]
  itineraryItems      ItineraryItem[]
  // FPP-43: PDF attachments hosted in the S3-compatible bucket.
  // The DB row owns the metadata (filename, size, scan status);
  // the bucket owns the bytes. Cascade-delete so removing an event
  // cleans up its attachments in one shot.
  attachments         EventAttachment[]

  @@index([status])
  @@index([date])
  @@index([rsvpDeadline])
  @@index([archivedAt])
  // FPP-68 / QUB-12: the past-events page runs `WHERE (archivedAt IS
  // NOT NULL OR (archivedAt IS NULL AND date < now)) ORDER BY date
  // DESC`. A composite index on `(archivedAt, date)` covers both the
  // filter and the sort so Postgres can skip a separate sort step.
  @@index([archivedAt, date])
}

// FPP-45 / QUB-31: per-event itinerary rows rendered on the event
// page Itinerary tab. `time` is a wall-clock time (no date) stored
// in the event's timezone; the admin form lets the host pick a time
// in the host's local clock and the rendered tab keeps that same
// wall-clock label so guests in other timezones see the host's
// intended wall-clock reading. `order` is the stable display order
// after drag-to-reorder; the page reads `order asc, time asc` so
// rows stay sorted even when two items share the same time.
model ItineraryItem {
  id          String   @id @default(cuid())
  eventId     String
  // Time-of-day (HH:MM:SS) without a date. Storing without a date
  // matches the "what time does the potluck start" admin intent and
  // avoids drift between the host's wall clock and a UTC instant.
  time        String?
  title       String
  description String?
  order       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, order])
}

// FPP-43: per-event PDF attachments (directions, waivers, schedules).
//
// One row per file. The bytes live in the S3-compatible bucket under
// `events/{eventId}/attachments/{userId}/{timestamp}-{filename}` and
// `key` is the canonical reference; `filename` is the human label the
// host typed at upload time (and is what guests see on the public
// page). `contentType` is captured at upload so a future content-type
// swap can't change what guests download. `sizeBytes` is captured so
// the public page can render a human-readable size without re-reading
// the object. `virusScanStatus` is PENDING on create and stays
// PENDING until a future scan worker marks it CLEAN/INFECTED/SKIPPED
// — for the first ship we log a stub and immediately set SKIPPED so
// downloads are not blocked behind an unfinished worker.
model EventAttachment {
  id               String               @id @default(cuid())
  eventId          String
  uploadedByUserId String
  // S3 object key (no bucket prefix). Re-derived at download time to
  // mint a fresh presigned URL; never rendered to the page directly.
  key              String               @unique
  // Human-readable filename shown on the public page (and used as the
  // download `Content-Disposition` filename on the presigned URL).
  filename         String
  contentType      String               @default("application/pdf")
  sizeBytes        Int
  virusScanStatus  AttachmentScanStatus @default(PENDING)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  event      Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  uploadedBy User  @relation(fields: [uploadedByUserId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([uploadedByUserId])
  @@index([virusScanStatus])
}

// FPP-43: virus-scan lifecycle. PENDING is the initial state and
// means "the scan worker hasn't picked this up yet" — for the first
// ship the API row-create path immediately moves new rows to SKIPPED
// so the public download is not blocked behind an unfinished worker.
// Future CLAMAV integration lands via a cron-style worker that flips
// PENDING rows to CLEAN / INFECTED.
enum AttachmentScanStatus {
  PENDING
  CLEAN
  INFECTED
  SKIPPED
  FAILED
}

model Invitation {
  id              String           @id @default(cuid())
  eventId         String
  userId          String?
  householdId     String?
  status          InvitationStatus @default(PENDING)
  invitedByUserId String
  createdAt       DateTime         @default(now())
  token           String?          @unique
  expiresAt       DateTime?
  sentAt          DateTime?

  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User?      @relation("UserInvitations", fields: [userId], references: [id])
  household Household? @relation(fields: [householdId], references: [id])
  invitedBy User       @relation("InvitedByUser", fields: [invitedByUserId], references: [id])

  @@unique([eventId, userId])
  @@unique([eventId, householdId])
  @@index([eventId])
  @@index([userId])
  @@index([householdId])
  @@index([invitedByUserId])
  @@index([status])
  @@index([token])
}

model RSVP {
  id               String     @id @default(cuid())
  eventId          String
  userId           String
  householdId      String
  status           RSVPStatus @default(INVITED)
  headcount        Int        @default(1)
  // FPP-55: the platform-level dietary restrictions field was removed
  // from the application. Historical values stay in the database column
  // for audit (the column is preserved but not exposed by Prisma); the
  // application no longer reads or writes it.
  respondedAt      DateTime?
  modifiedAt       DateTime   @updatedAt
  waitlistPosition Int?
  // FPP-88: optional note the guest attaches when declining. Persisted
  // to the column and forwarded to the event owner via a
  // CommunicationLog row so the note actually reaches them.
  declineMessage   String?    @db.Text

  event             Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  potluckSignups    PotluckSignup[]
  memberAttendances RsvpMemberAttendance[]

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@index([householdId])
  @@index([status])
  @@index([waitlistPosition])
}

model PotluckSlot {
  id             String          @id @default(cuid())
  eventId        String
  category       PotluckCategory
  // FPP-54: slot name is optional. Admins may leave it blank to create
  // an open slot in a category (e.g. "A dessert" with no specific dish).
  // The specific dish lives on the user's claim (PotluckSignup.dishName).
  name           String?
  slotType       SlotType
  maxSignups     Int?
  currentSignups Int             @default(0)

  event   Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  signups PotluckSignup[]

  @@index([eventId])
  @@index([category])
}

model PotluckSignup {
  id            String    @id @default(cuid())
  slotId        String
  rsvpId        String
  dishName      String
  servings      Int       @default(1)
  dietaryLabels String[]
  claimedAt     DateTime  @default(now())
  // FPP-Postmortem: soft-delete column. Hard delete is blocked at the DB
  // level by the `PotluckSignup_no_delete` trigger (see migration). Every
  // read path MUST filter `deletedAt: null` so soft-deleted rows never
  // surface to users; the trigger prevents an accidental psql/Studio wipe
  // like the 2026-08-19 incident that wiped 19 signups for one event.
  deletedAt     DateTime?

  slot PotluckSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  rsvp RSVP        @relation(fields: [rsvpId], references: [id], onDelete: Cascade)

  // Multi-claim per RSVP: a household can bring several distinct items
  // in the same category slot. Each signup row is uniquely identified
  // by its `id`; the human-readable disambiguator is `dishName`.
  // Capacity on `PotluckSlot.maxSignups` still counts every signup
  // against the slot.
  @@index([slotId])
  @@index([rsvpId])
  @@index([deletedAt])
}

model CommunicationLog {
  id              String               @id @default(cuid())
  eventId         String
  sentByUserId    String
  recipientUserId String?
  channel         CommunicationChannel
  // FPP-88 review: disambiguates the `body` payload. FPP-88
  // introduced the `body` column for two distinct purposes
  // (invitation URL, decline note). The `kind` column tells
  // the send pipeline which shape `body` has so a future
  // queue reader can branch without sniffing the body. Defaults
  // to BROADCAST so pre-FPP-88 rows and unrelated broadcast
  // writes keep working without a code change.
  kind            CommunicationLogKind @default(BROADCAST)
  messageId       String?
  toPhoneNumber   String?
  fromPhoneNumber String?
  status          CommunicationStatus  @default(QUEUED)
  errorCode       String?
  errorMessage    String?
  attemptedAt     DateTime             @default(now())
  deliveredAt     DateTime?
  // FPP-88: payload body. Shape depends on `kind`:
  //   - INVITATION:    `<baseUrl>/events/invitation/<token>`
  //   - DECLINE_NOTE:  free-form note text
  //   - BROADCAST:     whatever the broadcast writer stored
  // Nullable for pre-FPP-88 rows.
  body            String?              @db.Text
  // FPP-101: number of times this row has been re-queued by the
  // retry-failed-comms script. Starts at 0 on creation; incremented
  // on every retry. The worker does not auto-retry; the admin runs
  // `bun run comms:retry-failed` to bump it.
  retryCount      Int                  @default(0)

  event     Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sentBy    User  @relation("SentByUser", fields: [sentByUserId], references: [id], onDelete: Cascade)
  recipient User? @relation("ReceivedByUser", fields: [recipientUserId], references: [id])

  @@index([eventId])
  @@index([recipientUserId])
  @@index([status])
  @@index([sentByUserId])
  @@index([kind])
}

model Photo {
  id               String    @id @default(cuid())
  eventId          String
  uploadedByUserId String
  householdId      String
  photoPrismId     String
  caption          String?
  url              String
  thumbnailUrl     String?
  createdAt        DateTime  @default(now())
  deletedAt        DateTime?

  event      Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  uploadedBy User            @relation(fields: [uploadedByUserId], references: [id], onDelete: Cascade)
  household  Household       @relation(fields: [householdId], references: [id])
  reactions  PhotoReaction[]

  @@index([eventId])
  @@index([uploadedByUserId])
  @@index([householdId])
  @@index([photoPrismId])
  @@index([deletedAt])
}

model PhotoReaction {
  id        String   @id @default(cuid())
  photoId   String
  userId    String
  reaction  String
  createdAt DateTime @default(now())

  photo Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([photoId, userId, reaction])
  @@index([photoId])
  @@index([userId])
}

model AdminAuditLog {
  id        String   @id @default(cuid())
  userId    String
  eventId   String?
  action    String
  oldValue  Json?
  newValue  Json?
  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([eventId])
  @@index([createdAt])
  @@index([action])
}

// FPP-50: domain-event audit log. Captures who did what to which subject
// (RSVP, PotluckSignup, EventAdmin, Registration, Charge, ...), with a
// free-form payload for the diff and the time it happened. Append-only
// at the DB level (see migration trigger).
model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  action      String
  subjectType String
  subjectId   String
  payload     Json?
  occurredAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([subjectType, subjectId])
  @@index([actorId, occurredAt])
  @@index([action])
  @@index([occurredAt])
}

// FPP-57 / QUB-19: third-party auth identities linked to a user account.
// Each row records one (provider, providerAccountId) pair that successfully
// signed in for a given user. Used by Apple and Facebook to enable
// account linking: a returning user with an existing row signs in directly,
// while a fresh email creates a row alongside the user.
//
// provider is one of: "google", "apple", "facebook" (string instead of
// enum so adding a future provider does not require a Prisma migration).
// providerAccountId is the provider's stable per-user subject id (`sub`
// for Apple, `id` for Facebook, `sub` for Google if/when we migrate it
// off email-based lookup).
model LinkedIdentity {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  // Optional snapshot of the email the provider returned at link time.
  // Useful for the profile UI and audit (Apple's private relay can return
  // a different email on each sign-in).
  emailSnapshot     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // A given provider account can only link to one user. Prevents the same
  // Apple sub from being claimed by two different accounts.
  @@unique([provider, providerAccountId])
  @@index([userId])
  @@index([provider])
}

enum AdminPermission {
  OWNER
  COADMIN
  INVITER
}

enum ScheduledBroadcastStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum RegistrationStatus {
  PENDING
  PAID
  REFUNDED
  FORFEITED
  CANCELLED
}

enum ChargeStatus {
  REQUIRES_PAYMENT_METHOD
  REQUIRES_CONFIRMATION
  REQUIRES_ACTION
  PROCESSING
  REQUIRES_CAPTURE
  SUCCEEDED
  CANCELED
  FAILED
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
}

model ScheduledBroadcast {
  id            String                   @id @default(cuid())
  eventId       String
  sentByUserId  String
  message       String
  channel       CommunicationChannel
  recipientType String
  recipientIds  Json?
  scheduledAt   DateTime
  status        ScheduledBroadcastStatus @default(PENDING)
  processedAt   DateTime?
  errorMessage  String?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  event  Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sentBy User  @relation("ScheduledByUser", fields: [sentByUserId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([sentByUserId])
  @@index([status])
  @@index([scheduledAt])
}

model EventAdmin {
  id        String          @id @default(cuid())
  eventId   String
  userId    String
  role      AdminPermission @default(COADMIN)
  createdAt DateTime        @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

model Registration {
  id            String             @id @default(cuid())
  eventId       String
  userId        String
  // The household the charge applies to. May be null for users without a
  // household record. Carried on the row for reporting, not used by Stripe.
  householdId   String?
  // Snapshot of the per-attendee fee at charge time. Immutable per
  // registration so that retroactive fee changes do not corrupt history.
  amountCents   Int
  currency      String             @default("usd")
  status        RegistrationStatus @default(PENDING)
  // Sum of SUCCEEDED refund amounts in cents. Used to derive "fully refunded"
  // and to render remaining-balance UI without re-querying the refunds table.
  refundedCents Int                @default(0)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  charges Charge[]
  refunds Refund[]

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@index([status])
}

model Charge {
  id                    String       @id @default(cuid())
  registrationId        String
  // Stripe's PaymentIntent id (pi_...). Unique globally. Stored on every
  // row even after the Stripe object is deleted so the audit trail survives.
  stripePaymentIntentId String       @unique
  // Snapshot of the charge amount. Equal to the registration amount for the
  // first attempt; retries and partial captures can differ.
  amountCents           Int
  currency              String       @default("usd")
  status                ChargeStatus @default(REQUIRES_PAYMENT_METHOD)
  // Hosted receipt URL from Stripe. Null until payment_intent.succeeded.
  receiptUrl            String?
  // Set the first time the receipt email goes out for this charge. The
  // webhook and the admin "resend receipt" action check this to avoid
  // re-mailing on retries.
  receiptSentAt         DateTime?
  // The last error code/message Stripe reported, if any. Helps the admin
  // triage a row without re-querying Stripe.
  lastErrorCode         String?
  lastErrorMessage      String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  refunds      Refund[]

  @@index([registrationId])
  @@index([status])
}

model Refund {
  id               String       @id @default(cuid())
  chargeId         String
  // Registration is denormalized onto the Refund for fast aggregation and to
  // keep refund rows queryable without joining through Charge -> Registration.
  registrationId   String
  // Stripe's Refund id (re_...). Unique when present; null until the refund
  // is created on Stripe's side.
  stripeRefundId   String?      @unique
  amountCents      Int
  currency         String       @default("usd")
  status           RefundStatus @default(PENDING)
  // Free-form reason captured from the admin ("duplicate", "fraudulent",
  // "requested_by_customer", or custom).
  reason           String?
  // The admin who issued the refund. Required: every refund is auditable.
  refundedByUserId String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  charge       Charge       @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  refundedBy   User         @relation("RefundIssuer", fields: [refundedByUserId], references: [id])

  @@index([chargeId])
  @@index([registrationId])
  @@index([status])
  @@index([refundedByUserId])
}
