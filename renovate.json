{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["bun", "github-actions"],
  "schedule": ["* 0-8 * * 1"],
  "timezone": "America/Los_Angeles",
  "prConcurrentLimit": 5,
  "labels": ["dependencies"],
  "commitMessagePrefix": "chore",
  "commitMessageAction": "update",
  "commitMessageTopic": "{{groupName}}",
  "commitMessageExtra": "<details>{{body}}</details>",
  "packageRules": [
    {
      "description": "Skip major version updates for bun packages",
      "matchManagers": ["bun"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Group production dependencies",
      "matchManagers": ["bun"],
      "matchDepTypes": ["dependencies"],
      "groupName": "production-dependencies",
      "commitMessageTopic": "production-dependencies"
    },
    {
      "description": "Group development dependencies",
      "matchManagers": ["bun"],
      "matchDepTypes": ["devDependencies"],
      "groupName": "development-dependencies",
      "commitMessagePrefix": "chore(deps-dev)"
    },
    {
      "description": "Group GitHub Actions",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions",
      "commitMessagePrefix": "ci"
    }
  ]
}
